
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0-android37.2</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>Agent.Mobile</RootNamespace>

    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>

    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>

    <ApplicationTitle>Agent</ApplicationTitle>
    <ApplicationId>dev.luna.agent</ApplicationId>
    <ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
    <ApplicationVersion>10</ApplicationVersion>

    <AndroidPackageFormat>apk</AndroidPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls"
                      Version="11.0.0" />
  </ItemGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" />

    <MauiSplashScreen
      Include="Resources\Splash\splash.svg"
      Color="#0D1016"
      BaseSize="256,256" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\agent.core\Agent.Core.csproj" />
  </ItemGroup>

</Project>
