<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Agent.Mobile.Pages.AiStoBuilderPage"
             BackgroundColor="{DynamicResource AppBackground}"
             Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="Auto,*">
        <Grid Padding="16,12" ColumnDefinitions="44,*" ColumnSpacing="10"
              BackgroundColor="{DynamicResource AppBackground}">
            <Button Text="‹" FontSize="25" Padding="0" WidthRequest="40" HeightRequest="40"
                    BackgroundColor="{DynamicResource Surface}" Clicked="OnBackClicked"
                    SemanticProperties.Description="Voltar para a lista de agentes" />
            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                <Label Text="{Binding PageTitle}" FontSize="19" FontAttributes="Bold" />
                <Label Text="Especialização guiada pelo Codex" FontSize="10"
                       TextColor="{DynamicResource TextSecondary}" />
            </VerticalStackLayout>
        </Grid>

        <ScrollView Grid.Row="1" IsEnabled="{Binding IsFormEnabled}">
            <VerticalStackLayout Padding="18,8,18,34" Spacing="15">
                <Border Padding="16" BackgroundColor="{DynamicResource AccentSurface}"
                        Stroke="{DynamicResource AccentStrong}" StrokeThickness="1"
                        StrokeShape="RoundRectangle 20">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="AiSTo" FontSize="25" FontAttributes="Bold"
                                   TextColor="{DynamicResource Accent}" />
                            <Border Grid.Column="1" Padding="9,5" BackgroundColor="{DynamicResource SurfaceRaised}"
                                    StrokeThickness="0" StrokeShape="RoundRectangle 11" VerticalOptions="Center">
                                <Label Text="OPCIONAL" FontSize="9" CharacterSpacing="0.8"
                                       FontAttributes="Bold" TextColor="{DynamicResource Accent}" />
                            </Border>
                        </Grid>
                        <Label Text="Artificial Intelligence Specialized in Tools" FontSize="10"
                               TextColor="{DynamicResource TextSecondary}" />
                        <Label Text="Configure um especialista para um assunto específico. O Codex continua sendo o motor de IA; o AiSTo organiza instruções, contexto, documentação e ferramentas para orientar o trabalho."
                               FontSize="12" LineHeight="1.25" />
                        <Label Text="Isso não treina um novo modelo nem cria outro provedor: é uma configuração especializada aplicada ao Codex quando o backend estiver conectado."
                               FontSize="10" TextColor="{DynamicResource TextSecondary}" />
                        <Label Text="Exemplo: um especialista em grandes projetos pode priorizar arquitetura, dependências, documentação oficial e revisão cuidadosa de mudanças."
                               FontSize="10" TextColor="{DynamicResource TextSecondary}" />
                    </VerticalStackLayout>
                </Border>

                <Border Padding="15" BackgroundColor="{DynamicResource Surface}"
                        Stroke="{DynamicResource AccentStrong}" StrokeThickness="1"
                        StrokeShape="RoundRectangle 17">
                    <VerticalStackLayout Spacing="9">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="CONSTRUIR COM AUXÍLIO DO CODEX" FontSize="10" FontAttributes="Bold"
                                   CharacterSpacing="0.6" TextColor="{DynamicResource Accent}" />
                            <Label Grid.Column="1" Text="AGUARDANDO RUNTIME" FontSize="9" FontAttributes="Bold"
                                   TextColor="{DynamicResource Warning}" />
                        </Grid>
                        <Label Text="Descreva o especialista uma única vez. O Codex poderá analisar o contexto disponível, consultar a documentação oficial e propor identidade, objetivo, instruções e ferramentas sem pedir que você preencha cada campo."
                               FontSize="12" LineHeight="1.25" />
                        <Editor x:Name="AiStoDraftBriefEditor" HeightRequest="104" AutoSize="TextChanges" IsEnabled="False"
                                MaxLength="4000" Placeholder="Ex.: Quero um especialista em Rust para projetos grandes. Deve analisar arquitetura, consultar a documentação oficial, revisar código e explicar decisões..."
                                SemanticProperties.Description="Descrição única do especialista que o Codex deverá ajudar a configurar" />
                        <Button Text="Gerar rascunho com Codex" IsEnabled="False" FontSize="12"
                                BackgroundColor="{DynamicResource SurfaceRaised}"
                                TextColor="{DynamicResource TextSecondary}" />
                        <Label Text="A geração automática está preparada no núcleo AiSTo, mas será ativada quando o App Server nativo passar pelo teste de viabilidade e for incluído no Android. Nenhuma resposta ou conexão é simulada nesta versão."
                               FontSize="10" TextColor="{DynamicResource TextSecondary}" />
                    </VerticalStackLayout>
                </Border>

                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" VerticalOptions="Center">
                    <Border Padding="8,5" BackgroundColor="{DynamicResource SurfaceSubtle}"
                            StrokeThickness="0" StrokeShape="RoundRectangle 9">
                        <Label Text="01" FontSize="9" FontAttributes="Bold" TextColor="{DynamicResource Accent}" />
                    </Border>
                    <Label Grid.Column="1" Text="Identidade do especialista" FontSize="15"
                           FontAttributes="Bold" VerticalTextAlignment="Center" />
                </Grid>

                <Border Padding="14" BackgroundColor="{DynamicResource Surface}"
                        Stroke="{DynamicResource Border}" StrokeThickness="1"
                        StrokeShape="RoundRectangle 17">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="68,*" ColumnSpacing="12">
                            <Border WidthRequest="64" HeightRequest="64" BackgroundColor="{DynamicResource AccentSurface}"
                                    Stroke="{DynamicResource Border}" StrokeShape="RoundRectangle 18">
                                <Grid>
                                    <Image Source="{Binding AvatarPath}" Aspect="AspectFill" IsVisible="{Binding HasAvatar}"
                                           SemanticProperties.Description="Foto do especialista AiSTo" />
                                    <Label Text="AI" IsVisible="{Binding IsAvatarFallbackVisible}" FontSize="18" FontAttributes="Bold"
                                           TextColor="{DynamicResource Accent}" HorizontalTextAlignment="Center"
                                           VerticalTextAlignment="Center" />
                                </Grid>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="5" VerticalOptions="Center">
                                <Label Text="Foto do agente" FontSize="12" FontAttributes="Bold" />
                                <Label Text="Use uma imagem do dispositivo. Ela será associada ao perfil." FontSize="10"
                                       TextColor="{DynamicResource TextSecondary}" />
                                <HorizontalStackLayout Spacing="7">
                                    <Button Text="Escolher foto" FontSize="10" Padding="10,6"
                                            BackgroundColor="{DynamicResource SurfaceRaised}" Clicked="OnChooseAvatarClicked" />
                                    <Button Text="Remover" FontSize="10" Padding="10,6"
                                            BackgroundColor="{DynamicResource SurfaceRaised}" TextColor="{DynamicResource Danger}"
                                            Clicked="OnRemoveAvatarClicked" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Grid>

                        <Label Text="Nome" FontSize="11" TextColor="{DynamicResource TextSecondary}" />
                        <Entry Placeholder="Ex.: Atlas, especialista em grandes projetos"
                               MaxLength="40" Text="{Binding Name, Mode=TwoWay}"
                               SemanticProperties.Description="Nome do agente especializado" />
                        <Label Text="Resumo do especialista" FontSize="11" TextColor="{DynamicResource TextSecondary}" />
                        <Entry Placeholder="O que este especialista faz?" MaxLength="180"
                               Text="{Binding Description, Mode=TwoWay}" />
                    </VerticalStackLayout>
                </Border>

                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" VerticalOptions="Center">
                    <Border Padding="8,5" BackgroundColor="{DynamicResource SurfaceSubtle}"
                            StrokeThickness="0" StrokeShape="RoundRectangle 9">
                        <Label Text="02" FontSize="9" FontAttributes="Bold" TextColor="{DynamicResource Accent}" />
                    </Border>
                    <Label Grid.Column="1" Text="Área e objetivo" FontSize="15"
                           FontAttributes="Bold" VerticalTextAlignment="Center" />
                </Grid>

                <Border Padding="14" BackgroundColor="{DynamicResource Surface}"
                        Stroke="{DynamicResource Border}" StrokeThickness="1"
                        StrokeShape="RoundRectangle 17">
                    <VerticalStackLayout Spacing="9">
                        <Label Text="Especialidade principal" FontSize="11" TextColor="{DynamicResource TextSecondary}" />
                        <Picker Title="Escolha uma área" SelectedItem="{Binding Domain, Mode=TwoWay}">
                            <Picker.Items>
                                <x:String>Grandes projetos e sistemas complexos</x:String>
                                <x:String>Arquitetura e revisão de código</x:String>
                                <x:String>Rust e sistemas nativos</x:String>
                                <x:String>.NET MAUI e aplicativos móveis</x:String>
                                <x:String>Frontend e experiência de usuário</x:String>
                                <x:String>Documentação técnica e APIs</x:String>
                                <x:String>Testes e qualidade de software</x:String>
                                <x:String>Especialidade personalizada</x:String>
                            </Picker.Items>
                        </Picker>
                        <Entry Placeholder="Ex.: Engenharia de dados, segurança web, astronomia..."
                               IsVisible="{Binding IsCustomDomain}" MaxLength="80"
                               Text="{Binding CustomDomain, Mode=TwoWay}" />
                        <Button Text="Carregar modelo inicial desta área" FontSize="10" Padding="10,7"
                                BackgroundColor="{DynamicResource SurfaceRaised}"
                                Clicked="OnLoadTemplateClicked" />
                        <Label Text="Objetivo principal" FontSize="11" TextColor="{DynamicResource TextSecondary}" />
                        <Editor Placeholder="Descreva o que o especialista deve resolver e qual resultado deve entregar..."
                                AutoSize="TextChanges" HeightRequest="94" MaxLength="1600"
                                Text="{Binding Objective, Mode=TwoWay}" />
                        <Label Text="Instruções específicas" FontSize="11" TextColor="{DynamicResource TextSecondary}" />
                        <Editor Placeholder="Explique como deve analisar, planejar, justificar decisões e comunicar resultados. Não inclua senhas ou tokens."
                                AutoSize="TextChanges" HeightRequest="130" MaxLength="8000"
                                Text="{Binding Instructions, Mode=TwoWay}" />
                        <Label Text="Contexto do projeto (opcional)" FontSize="11" TextColor="{DynamicResource TextSecondary}" />
                        <Editor Placeholder="Stack, convenções, limitações, estrutura conhecida e decisões já tomadas..."
                                AutoSize="TextChanges" HeightRequest="92" MaxLength="5000"
                                Text="{Binding ProjectContext, Mode=TwoWay}" />
                        <Label Text="Estilo de resposta" FontSize="11" TextColor="{DynamicResource TextSecondary}" />
                        <Picker Title="Como deve responder?" SelectedItem="{Binding ResponseStyle, Mode=TwoWay}">
                            <Picker.Items>
                                <x:String>Passo a passo</x:String>
                                <x:String>Objetivo e conciso</x:String>
                                <x:String>Detalhado e explicativo</x:String>
                                <x:String>Revisão crítica</x:String>
                            </Picker.Items>
                        </Picker>
                    </VerticalStackLayout>
                </Border>

                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" VerticalOptions="Center">
                    <Border Padding="8,5" BackgroundColor="{DynamicResource SurfaceSubtle}"
                            StrokeThickness="0" StrokeShape="RoundRectangle 9">
                        <Label Text="03" FontSize="9" FontAttributes="Bold" TextColor="{DynamicResource Accent}" />
                    </Border>
                    <Label Grid.Column="1" Text="Conhecimento e contexto" FontSize="15"
                           FontAttributes="Bold" VerticalTextAlignment="Center" />
                </Grid>

                <Border Padding="14" BackgroundColor="{DynamicResource Surface}"
                        Stroke="{DynamicResource Border}" StrokeThickness="1"
                        StrokeShape="RoundRectangle 17">
                    <VerticalStackLayout Spacing="9">
                        <Label Text="Documentação de referência" FontSize="12" FontAttributes="Bold" />
                        <Label Text="Adicione URLs HTTPS de documentação oficial, uma por linha. Nesta etapa elas serão salvas como referências; a consulta e a atualização serão feitas pelo backend. Não use links assinados, tokens ou URLs privadas."
                               FontSize="10" TextColor="{DynamicResource TextSecondary}" />
                        <Editor Placeholder="https://doc.rust-lang.org/book/&#10;https://learn.microsoft.com/dotnet/maui/"
                                AutoSize="TextChanges" HeightRequest="90" MaxLength="4000"
                                Text="{Binding DocumentationSourcesText, Mode=TwoWay}" />
                        <BoxView HeightRequest="1" Color="{DynamicResource Border}" />
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="9">
                            <VerticalStackLayout Spacing="1">
                                <Label Text="Navegação semântica" FontSize="12" />
                                <Label Text="Relacionar arquivos, símbolos e dependências." FontSize="9" TextColor="{DynamicResource TextMuted}" />
                            </VerticalStackLayout>
                            <Switch Grid.Column="1" IsToggled="{Binding UseSemanticNavigation, Mode=TwoWay}" />
                            <VerticalStackLayout Grid.Row="1" Spacing="1">
                                <Label Text="Documentação atualizada" FontSize="12" />
                                <Label Text="Priorizar fontes oficiais e versões compatíveis." FontSize="9" TextColor="{DynamicResource TextMuted}" />
                            </VerticalStackLayout>
                            <Switch Grid.Row="1" Grid.Column="1" IsToggled="{Binding PreferUpdatedDocumentation, Mode=TwoWay}" />
                            <VerticalStackLayout Grid.Row="2" Spacing="1">
                                <Label Text="Regras de arquitetura" FontSize="12" />
                                <Label Text="Respeitar convenções e limites do projeto." FontSize="9" TextColor="{DynamicResource TextMuted}" />
                            </VerticalStackLayout>
                            <Switch Grid.Row="2" Grid.Column="1" IsToggled="{Binding ApplyArchitectureRules, Mode=TwoWay}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" VerticalOptions="Center">
                    <Border Padding="8,5" BackgroundColor="{DynamicResource SurfaceSubtle}"
                            StrokeThickness="0" StrokeShape="RoundRectangle 9">
                        <Label Text="04" FontSize="9" FontAttributes="Bold" TextColor="{DynamicResource Accent}" />
                    </Border>
                    <Label Grid.Column="1" Text="Ferramentas e limites" FontSize="15"
                           FontAttributes="Bold" VerticalTextAlignment="Center" />
                </Grid>

                <Border Padding="14" BackgroundColor="{DynamicResource Surface}"
                        Stroke="{DynamicResource Border}" StrokeThickness="1"
                        StrokeShape="RoundRectangle 17">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Ferramentas solicitadas" FontSize="12" FontAttributes="Bold" />
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="9">
                            <VerticalStackLayout Spacing="1">
                                <Label Text="Ler repositórios" FontSize="12" />
                                <Label Text="Consultar arquivos selecionados." FontSize="9" TextColor="{DynamicResource TextMuted}" />
                            </VerticalStackLayout>
                            <Switch Grid.Column="1" IsToggled="{Binding CanReadRepositories, Mode=TwoWay}" />
                            <VerticalStackLayout Grid.Row="1" Spacing="1">
                                <Label Text="Propor alterações" FontSize="12" />
                                <Label Text="Preparar mudanças para revisão." FontSize="9" TextColor="{DynamicResource TextMuted}" />
                            </VerticalStackLayout>
                            <Switch Grid.Row="1" Grid.Column="1" IsToggled="{Binding CanWriteRepositories, Mode=TwoWay}" />
                            <VerticalStackLayout Grid.Row="2" Spacing="1">
                                <Label Text="Consultar a web" FontSize="12" />
                                <Label Text="Pesquisar conteúdo e referências públicas." FontSize="9" TextColor="{DynamicResource TextMuted}" />
                            </VerticalStackLayout>
                            <Switch Grid.Row="2" Grid.Column="1" IsToggled="{Binding CanBrowseWeb, Mode=TwoWay}" />
                        </Grid>
                        <Border Padding="11" BackgroundColor="{DynamicResource AccentSurface}"
                                StrokeThickness="0" StrokeShape="RoundRectangle 13">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Proteção obrigatória" FontSize="11" FontAttributes="Bold"
                                       TextColor="{DynamicResource Accent}" />
                                <Label Text="As opções abaixo descrevem as ferramentas que o especialista poderá solicitar ao runtime. Elas não concedem acesso por conta própria; o backend e a seleção explícita do usuário continuam responsáveis por autorizar cada operação."
                                       FontSize="10" TextColor="{DynamicResource TextSecondary}" />
                                <Label Text="A escrita exige leitura do repositório. Alterações devem ser apresentadas como diff revisável e não devem ser aplicadas ou publicadas sem aprovação explícita."
                                       FontSize="10" TextColor="{DynamicResource TextSecondary}" />
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <Border Padding="14" BackgroundColor="{DynamicResource Surface}"
                        Stroke="{DynamicResource Border}" StrokeThickness="1"
                        StrokeShape="RoundRectangle 17">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Prévia do especialista" FontSize="13" FontAttributes="Bold" />
                        <Label Text="{Binding PreviewName}" FontSize="16" FontAttributes="Bold"
                               TextColor="{DynamicResource Accent}" />
                        <Label Text="{Binding PreviewDomain}" FontSize="11"
                               TextColor="{DynamicResource TextSecondary}" />
                        <Label Text="{Binding PreviewObjective}" FontSize="11" />
                        <Label Text="{Binding PreviewDetails}" FontSize="10"
                               TextColor="{DynamicResource TextMuted}" />
                    </VerticalStackLayout>
                </Border>

                <Border Padding="12" BackgroundColor="{DynamicResource Surface}"
                        Stroke="{DynamicResource Danger}" StrokeThickness="1"
                        StrokeShape="RoundRectangle 13"
                        IsVisible="{Binding HasError}">
                    <Label Text="{Binding ErrorMessage}" FontSize="11"
                           TextColor="{DynamicResource Danger}" />
                </Border>

                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                                   Color="{DynamicResource Accent}" HorizontalOptions="Center" />

                <Grid ColumnDefinitions="*,*" ColumnSpacing="9">
                    <Button Text="Cancelar" Grid.Column="0" FontSize="12"
                            BackgroundColor="{DynamicResource SurfaceRaised}"
                            Clicked="OnCancelClicked" />
                    <Button Text="{Binding SaveButtonText}" Grid.Column="1" FontSize="12"
                            BackgroundColor="{DynamicResource AccentStrong}"
                            Clicked="OnSaveClicked" />
                </Grid>

                <Button Text="Remover especialização AiSTo" FontSize="11"
                        BackgroundColor="{DynamicResource SurfaceRaised}"
                        TextColor="{DynamicResource Danger}"
                        IsVisible="{Binding CanRemoveAiSto}"
                        Clicked="OnRemoveAiStoClicked" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
