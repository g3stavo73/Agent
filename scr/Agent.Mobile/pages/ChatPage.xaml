<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Agent.Mobile.Pages.ChatPage"
             BackgroundColor="{DynamicResource AppBackground}"
             Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="18,12,18,12" RowSpacing="12">
        <Grid Grid.Row="0" ColumnDefinitions="44,*,Auto" ColumnSpacing="11"
              VerticalOptions="Center">
            <Border WidthRequest="42" HeightRequest="42"
                    Stroke="{DynamicResource Border}" StrokeThickness="1"
                    BackgroundColor="{DynamicResource Surface}"
                    StrokeShape="RoundRectangle 14">
                <Label Text="A" FontSize="22" FontAttributes="Bold"
                       TextColor="{DynamicResource Accent}"
                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
            </Border>
            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                <Label Text="Agent" FontSize="20" FontAttributes="Bold"
                       SemanticProperties.HeadingLevel="Level1" />
                <Label Text="ESPAÇO DE TRABALHO" FontSize="9" CharacterSpacing="1.1"
                       TextColor="{DynamicResource TextMuted}" />
            </VerticalStackLayout>
            <Border Grid.Column="2" Padding="9,7"
                    BackgroundColor="{DynamicResource SurfaceRaised}"
                    StrokeThickness="0" StrokeShape="RoundRectangle 20"
                    VerticalOptions="Center">
                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                    <Ellipse WidthRequest="7" HeightRequest="7"
                             Fill="{DynamicResource Warning}" />
                    <Label Text="OFFLINE" FontSize="9" FontAttributes="Bold"
                           TextColor="{DynamicResource Warning}" />
                </HorizontalStackLayout>
            </Border>
        </Grid>

        <Border Grid.Row="1" Padding="12,10"
                BackgroundColor="{DynamicResource Surface}"
                Stroke="{DynamicResource Border}" StrokeThickness="1"
                StrokeShape="RoundRectangle 14">
            <Grid ColumnDefinitions="34,*" ColumnSpacing="10">
                <Border WidthRequest="32" HeightRequest="32"
                        BackgroundColor="{DynamicResource SurfaceSubtle}"
                        StrokeThickness="0" StrokeShape="RoundRectangle 10">
                    <Label Text="⌘" FontSize="17" TextColor="{DynamicResource Accent}"
                           HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                </Border>
                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                    <Label Text="WORKSPACE" FontSize="9" CharacterSpacing="1"
                           TextColor="{DynamicResource TextMuted}" />
                    <Label Text="Nenhum projeto selecionado" FontSize="12"
                           FontAttributes="Bold" />
                </VerticalStackLayout>
            </Grid>
        </Border>

        <ScrollView Grid.Row="2" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Spacing="14" Padding="0,8,0,18">
                <Border Padding="18" BackgroundColor="{DynamicResource Surface}"
                        Stroke="{DynamicResource Border}" StrokeThickness="1"
                        StrokeShape="RoundRectangle 20">
                    <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                        <Border WidthRequest="58" HeightRequest="58"
                                BackgroundColor="{DynamicResource AccentSurface}"
                                StrokeThickness="0" StrokeShape="RoundRectangle 19"
                                HorizontalOptions="Center">
                            <Label Text="C" FontSize="28" FontAttributes="Bold"
                                   TextColor="{DynamicResource Accent}"
                                   HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        </Border>
                        <Label Text="Conecte o runtime do Codex" FontSize="17"
                               FontAttributes="Bold" HorizontalTextAlignment="Center" />
                        <Label Text="Quando o App Server estiver integrado, suas conversas e tarefas aparecerão aqui. Nenhuma mensagem será enviada enquanto a conexão estiver indisponível." 
                               FontSize="12" LineHeight="1.3"
                               TextColor="{DynamicResource TextSecondary}"
                               HorizontalTextAlignment="Center" />
                        <Border Padding="9,6" BackgroundColor="{DynamicResource SurfaceRaised}"
                                StrokeThickness="0" StrokeShape="RoundRectangle 10">
                            <Label Text="RUNTIME NÃO CONECTADO NESTA BUILD"
                                   FontSize="9" FontAttributes="Bold" CharacterSpacing="0.4"
                                   TextColor="{DynamicResource Warning}" />
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                    <Border Padding="10" BackgroundColor="{DynamicResource Surface}"
                            Stroke="{DynamicResource Border}" StrokeThickness="1"
                            StrokeShape="RoundRectangle 13">
                        <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                            <Label Text="CHAT" FontSize="10" FontAttributes="Bold"
                                   TextColor="{DynamicResource Accent}" />
                            <Label Text="Aguardando" FontSize="9"
                                   TextColor="{DynamicResource TextSecondary}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" Padding="10" BackgroundColor="{DynamicResource Surface}"
                            Stroke="{DynamicResource Border}" StrokeThickness="1"
                            StrokeShape="RoundRectangle 13">
                        <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                            <Label Text="TOOLS" FontSize="10" FontAttributes="Bold"
                                   TextColor="{DynamicResource Accent}" />
                            <Label Text="Aguardando" FontSize="9"
                                   TextColor="{DynamicResource TextSecondary}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="2" Padding="10" BackgroundColor="{DynamicResource Surface}"
                            Stroke="{DynamicResource Border}" StrokeThickness="1"
                            StrokeShape="RoundRectangle 13">
                        <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                            <Label Text="REVIEW" FontSize="10" FontAttributes="Bold"
                                   TextColor="{DynamicResource Accent}" />
                            <Label Text="Aguardando" FontSize="9"
                                   TextColor="{DynamicResource TextSecondary}" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <ContentView x:Name="AgentUiHost" IsVisible="False" />
            </VerticalStackLayout>
        </ScrollView>

        <Border Grid.Row="3" Padding="12,10"
                BackgroundColor="{DynamicResource Surface}"
                Stroke="{DynamicResource Border}" StrokeThickness="1"
                StrokeShape="RoundRectangle 18">
            <VerticalStackLayout Spacing="8">
                <Editor Placeholder="Conecte o Codex para começar uma conversa..."
                        HeightRequest="56" AutoSize="TextChanges" IsEnabled="False"
                        SemanticProperties.Description="Campo de mensagem, aguardando conexão com o Codex" />
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                    <Button Text="＋" WidthRequest="44" HeightRequest="44" Padding="0"
                            FontSize="20" IsEnabled="False"
                            BackgroundColor="{DynamicResource SurfaceRaised}"
                            SemanticProperties.Description="Anexar arquivo, indisponível sem runtime" />
                    <Label Grid.Column="1" Text="Aguardando conexão segura"
                           FontSize="10" TextColor="{DynamicResource TextMuted}"
                           VerticalTextAlignment="Center" />
                    <Button Grid.Column="2" Text="↑" WidthRequest="44" HeightRequest="44"
                            Padding="0" FontSize="20" IsEnabled="False"
                            BackgroundColor="{DynamicResource AccentStrong}"
                            SemanticProperties.Description="Enviar mensagem, indisponível sem runtime" />
                </Grid>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
