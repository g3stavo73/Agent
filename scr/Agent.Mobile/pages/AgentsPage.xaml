<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Agent.Mobile.Pages.AgentsPage"
             BackgroundColor="{DynamicResource AppBackground}"
             Shell.NavBarIsVisible="False">
    <ScrollView>
        <VerticalStackLayout Padding="20,24,20,30" Spacing="17">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Agentes" FontSize="28" FontAttributes="Bold"
                           SemanticProperties.HeadingLevel="Level1" />
                    <Label Text="Perfis de trabalho para o Codex, com identidade e permissões próprias."
                           FontSize="12" TextColor="{DynamicResource TextSecondary}" />
                </VerticalStackLayout>
                <Button Grid.Column="1" Text="＋ Novo" Padding="13,9" FontSize="12"
                        BackgroundColor="{DynamicResource AccentStrong}" Clicked="OnNewAgentClicked"
                        VerticalOptions="Center" SemanticProperties.Description="Criar um novo agente" />
            </Grid>

            <Border Padding="15" BackgroundColor="{DynamicResource Surface}" Stroke="{DynamicResource Border}"
                    StrokeThickness="1" StrokeShape="RoundRectangle 18">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="34,*" ColumnSpacing="10">
                        <Border WidthRequest="34" HeightRequest="34" BackgroundColor="{DynamicResource AccentSurface}"
                                StrokeThickness="0" StrokeShape="RoundRectangle 11">
                            <Label Text="C" FontSize="17" FontAttributes="Bold" TextColor="{DynamicResource Accent}"
                                   HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="Codex padrão" FontSize="14" FontAttributes="Bold" />
                            <Label Text="Motor ativo · sem especialização obrigatória" FontSize="10"
                                   TextColor="{DynamicResource Success}" />
                        </VerticalStackLayout>
                    </Grid>
                    <Label Text="Use o Codex normalmente para conversar, analisar projetos e executar tarefas. Todos os agentes desta versão usam apenas o Codex."
                           FontSize="11" TextColor="{DynamicResource TextSecondary}" />
                    <BoxView HeightRequest="1" Color="{DynamicResource Border}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="AiSTo" FontSize="14" FontAttributes="Bold" />
                            <Label Text="Artificial Intelligence Specialized in Tools" FontSize="9"
                                   TextColor="{DynamicResource TextSecondary}" />
                        </VerticalStackLayout>
                        <Border Grid.Column="1" Padding="9,5" BackgroundColor="{DynamicResource AccentSurface}"
                                StrokeThickness="0" StrokeShape="RoundRectangle 12" VerticalOptions="Center">
                            <Label Text="DISPONÍVEL PARA CONFIGURAR" FontSize="8" CharacterSpacing="0.35" FontAttributes="Bold"
                                   TextColor="{DynamicResource Accent}" />
                        </Border>
                    </Grid>
                    <Label Text="Configure um especialista por assunto usando o Codex como motor. Defina objetivo, instruções, fontes de conhecimento e ferramentas desejadas. A execução será conectada pelo backend."
                           FontSize="11" TextColor="{DynamicResource TextSecondary}" />
                    <Button Text="Criar especialista AiSTo" BackgroundColor="{DynamicResource AccentStrong}"
                            Clicked="OnCreateAiStoClicked" SemanticProperties.Description="Abrir o configurador de especialistas AiSTo" />
                    <Label Text="OPCIONAL · O CODEX NORMAL CONTINUA DISPONÍVEL" FontSize="9"
                           CharacterSpacing="0.45" TextColor="{DynamicResource Success}" />
                </VerticalStackLayout>
            </Border>

            <Border Padding="15" BackgroundColor="{DynamicResource Surface}" Stroke="{DynamicResource Border}"
                    StrokeThickness="1" StrokeShape="RoundRectangle 18">
                <VerticalStackLayout Spacing="9">
                    <Grid ColumnDefinitions="36,*" ColumnSpacing="10">
                        <Border WidthRequest="34" HeightRequest="34" BackgroundColor="{DynamicResource SurfaceSubtle}"
                                StrokeThickness="0" StrokeShape="RoundRectangle 11">
                            <Label Text="GH" FontSize="11" FontAttributes="Bold" TextColor="{DynamicResource Accent}"
                                   HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="GitHub" FontSize="14" FontAttributes="Bold" />
                            <Label Text="Conexão não configurada" FontSize="10"
                                   TextColor="{DynamicResource TextSecondary}" />
                        </VerticalStackLayout>
                    </Grid>
                    <Label Text="O agente poderá ler e propor alterações nos repositórios selecionados. A integração e as permissões serão aplicadas pelo backend; nenhuma conta ou repositório está conectado nesta prévia."
                           FontSize="11" TextColor="{DynamicResource TextSecondary}" />
                    <Button Text="Conectar GitHub" IsEnabled="False" BackgroundColor="{DynamicResource SurfaceRaised}"
                            TextColor="{DynamicResource TextMuted}" />
                    <Label Text="INTEGRAÇÃO PENDENTE · NENHUM ACESSO CONCEDIDO" FontSize="9"
                           CharacterSpacing="0.5" TextColor="{DynamicResource Warning}" />
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*,Auto">
                <Label Text="Seus agentes" FontSize="17" FontAttributes="Bold" VerticalTextAlignment="Center" />
                <Label Grid.Column="1" x:Name="AgentCountLabel" Text="0 agentes" FontSize="10"
                       TextColor="{DynamicResource TextMuted}" VerticalTextAlignment="Center" />
            </Grid>

            <Border x:Name="EmptyState" Padding="18,22" BackgroundColor="{DynamicResource Surface}"
                    Stroke="{DynamicResource Border}" StrokeThickness="1" StrokeShape="RoundRectangle 18">
                <VerticalStackLayout Spacing="7" HorizontalOptions="Center">
                    <Label Text="◇" FontSize="28" TextColor="{DynamicResource Accent}"
                           HorizontalTextAlignment="Center" />
                    <Label Text="Nenhum agente criado" FontSize="14" FontAttributes="Bold"
                           HorizontalTextAlignment="Center" />
                    <Label Text="Crie um perfil com nome, foto e preferências. A execução continuará dependendo da conexão com o Codex e dos serviços do backend."
                           FontSize="11" TextColor="{DynamicResource TextSecondary}"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout x:Name="AgentsList" IsVisible="False" Spacing="10" />

            <Border x:Name="EditorPanel" IsVisible="False" Padding="16"
                    BackgroundColor="{DynamicResource SurfaceRaised}" Stroke="{DynamicResource AccentStrong}"
                    StrokeThickness="1" StrokeShape="RoundRectangle 18">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label x:Name="EditorTitle" Text="Novo agente" FontSize="17" FontAttributes="Bold"
                               VerticalTextAlignment="Center" />
                        <Button Grid.Column="1" Text="Fechar" FontSize="10" Padding="9,6"
                                BackgroundColor="{DynamicResource Surface}" Clicked="OnCancelEditorClicked" />
                    </Grid>

                    <Grid ColumnDefinitions="66,*" ColumnSpacing="12">
                        <Border WidthRequest="62" HeightRequest="62" BackgroundColor="{DynamicResource AccentSurface}"
                                Stroke="{DynamicResource Border}" StrokeShape="RoundRectangle 18">
                            <Grid>
                                <Image x:Name="AvatarPreview" Aspect="AspectFill" IsVisible="False"
                                       SemanticProperties.Description="Foto selecionada para o agente" />
                                <Label x:Name="AvatarFallback" Text="AG" FontSize="17" FontAttributes="Bold"
                                       TextColor="{DynamicResource Accent}" HorizontalTextAlignment="Center"
                                       VerticalTextAlignment="Center" />
                            </Grid>
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="5" VerticalOptions="Center">
                            <Label Text="Foto do agente" FontSize="12" FontAttributes="Bold" />
                            <Label Text="Escolha uma imagem do dispositivo (até 20 MB). Ela será copiada para o armazenamento privado do app."
                                   FontSize="10" TextColor="{DynamicResource TextSecondary}" />
                            <HorizontalStackLayout Spacing="7">
                                <Button Text="Escolher" FontSize="10" Padding="10,6"
                                        BackgroundColor="{DynamicResource Surface}" Clicked="OnChooseAvatarClicked" />
                                <Button Text="Remover" FontSize="10" Padding="10,6"
                                        BackgroundColor="{DynamicResource Surface}" TextColor="{DynamicResource Danger}"
                                        Clicked="OnRemoveAvatarClicked" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Grid>

                    <Label Text="Nome do agente" FontSize="11" TextColor="{DynamicResource TextSecondary}" />
                    <Entry x:Name="AgentNameEntry" Placeholder="Ex.: Atlas, Neko, Code Reviewer"
                           MaxLength="40" ReturnType="Next" Completed="OnAgentNameCompleted"
                           SemanticProperties.Description="Nome de exibição do agente" />
                    <Label Text="Descrição e especialidade" FontSize="11" TextColor="{DynamicResource TextSecondary}" />
                    <Editor x:Name="AgentDescriptionEditor" Placeholder="Explique a função e o contexto deste agente..."
                            AutoSize="TextChanges" HeightRequest="78" MaxLength="1200"
                            SemanticProperties.Description="Descrição e especialidade do agente, até 1200 caracteres" />

                    <Border Padding="12" BackgroundColor="{DynamicResource Surface}" Stroke="{DynamicResource Border}"
                            StrokeThickness="1" StrokeShape="RoundRectangle 14">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Motor de IA" FontSize="11" FontAttributes="Bold" />
                            <Label Text="Codex padrão · selecionado" FontSize="12" TextColor="{DynamicResource Success}" />
                            <Label Text="Use o configurador AiSTo para definir uma especialidade. O Codex continua sendo o motor de IA."
                                   FontSize="10" TextColor="{DynamicResource TextSecondary}" />
                        </VerticalStackLayout>
                    </Border>

                    <Label Text="Acesso solicitado" FontSize="12" FontAttributes="Bold" />
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                        <VerticalStackLayout Spacing="1">
                            <Label Text="Ler repositórios" FontSize="12" />
                            <Label Text="Consultar arquivos e histórico selecionados." FontSize="9"
                                   TextColor="{DynamicResource TextMuted}" />
                        </VerticalStackLayout>
                        <Switch x:Name="ReadRepositorySwitch" Grid.Column="1" IsToggled="True"
                                SemanticProperties.Description="Solicitar leitura dos repositórios" />
                        <VerticalStackLayout Grid.Row="1" Spacing="1">
                            <Label Text="Modificar repositórios" FontSize="12" />
                            <Label Text="Propor e preparar alterações; publicação exige revisão." FontSize="9"
                                   TextColor="{DynamicResource TextMuted}" />
                        </VerticalStackLayout>
                        <Switch x:Name="WriteRepositorySwitch" Grid.Row="1" Grid.Column="1"
                                SemanticProperties.Description="Solicitar permissão para modificar repositórios" />
                        <VerticalStackLayout Grid.Row="2" Spacing="1">
                            <Label Text="Consultar a web" FontSize="12" />
                            <Label Text="Pesquisar referências e documentação." FontSize="9"
                                   TextColor="{DynamicResource TextMuted}" />
                        </VerticalStackLayout>
                        <Switch x:Name="WebAccessSwitch" Grid.Row="2" Grid.Column="1" IsToggled="True"
                                SemanticProperties.Description="Solicitar consultas à web" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="{DynamicResource Border}" />
                    <Label Text="Contexto e qualidade do projeto" FontSize="12" FontAttributes="Bold" />
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                        <VerticalStackLayout Spacing="1">
                            <Label Text="Navegação semântica" FontSize="12" />
                            <Label Text="Entender símbolos, relações e dependências." FontSize="9"
                                   TextColor="{DynamicResource TextMuted}" />
                        </VerticalStackLayout>
                        <Switch x:Name="SemanticNavigationSwitch" Grid.Column="1" IsToggled="True"
                                SemanticProperties.Description="Usar navegação e entendimento semântico do projeto" />
                        <VerticalStackLayout Grid.Row="1" Spacing="1">
                            <Label Text="Documentação atualizada" FontSize="12" />
                            <Label Text="Priorizar fontes oficiais e versões compatíveis." FontSize="9"
                                   TextColor="{DynamicResource TextMuted}" />
                        </VerticalStackLayout>
                        <Switch x:Name="UpdatedDocsSwitch" Grid.Row="1" Grid.Column="1" IsToggled="True"
                                SemanticProperties.Description="Priorizar documentação oficial e atualizada" />
                        <VerticalStackLayout Grid.Row="2" Spacing="1">
                            <Label Text="Regras de arquitetura" FontSize="12" />
                            <Label Text="Considerar as convenções e limites do projeto." FontSize="9"
                                   TextColor="{DynamicResource TextMuted}" />
                        </VerticalStackLayout>
                        <Switch x:Name="ArchitectureRulesSwitch" Grid.Row="2" Grid.Column="1" IsToggled="True"
                                SemanticProperties.Description="Aplicar regras de arquitetura do projeto" />
                    </Grid>
                    <Label Text="Estas opções são preferências salvas no perfil. A execução real, a indexação e a validação serão implementadas no backend."
                           FontSize="10" TextColor="{DynamicResource TextSecondary}" />
                    <Label x:Name="EditorErrorLabel" IsVisible="False" FontSize="10"
                           TextColor="{DynamicResource Danger}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Button x:Name="SaveAgentButton" Text="Criar agente" BackgroundColor="{DynamicResource AccentStrong}"
                                Clicked="OnSaveAgentClicked" />
                        <Button Grid.Column="1" Text="Cancelar" BackgroundColor="{DynamicResource Surface}"
                                FontSize="11" Clicked="OnCancelEditorClicked" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
