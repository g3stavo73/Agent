<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Agent.Mobile.Pages.WelcomePage"
             BackgroundColor="{DynamicResource AppBackground}"
             Shell.NavBarIsVisible="False">
    <ScrollView VerticalScrollBarVisibility="Never">
        <VerticalStackLayout Padding="22,28,22,30"
                             Spacing="18"
                             HorizontalOptions="Center"
                             MaximumWidthRequest="560">
            <Grid ColumnDefinitions="54,*" ColumnSpacing="13">
                <Border WidthRequest="52" HeightRequest="52"
                        BackgroundColor="{DynamicResource AccentSurface}"
                        Stroke="{DynamicResource Border}" StrokeThickness="1"
                        StrokeShape="RoundRectangle 17">
                    <Label Text="A" FontSize="29" FontAttributes="Bold"
                           TextColor="{DynamicResource Accent}"
                           HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                </Border>
                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                    <Label Text="AGENT" FontSize="12" CharacterSpacing="2.2"
                           FontAttributes="Bold" TextColor="{DynamicResource Accent}" />
                    <Label Text="Seu espaço de desenvolvimento" FontSize="19"
                           FontAttributes="Bold" />
                    <Label Text="Cliente Android · versão Alpha" FontSize="11"
                           TextColor="{DynamicResource TextSecondary}" />
                </VerticalStackLayout>
            </Grid>

            <Border Padding="19" BackgroundColor="{DynamicResource Surface}"
                    Stroke="{DynamicResource Border}" StrokeThickness="1"
                    StrokeShape="RoundRectangle 20">
                <VerticalStackLayout Spacing="9">
                    <Label Text="Código, contexto e assistência." FontSize="23"
                           FontAttributes="Bold" LineBreakMode="WordWrap" />
                    <Label Text="O Agent está em fase de integração. Esta versão permite explorar a interface; autenticação e execução ainda dependem de componentes que não estão ligados ao aplicativo Android." 
                           FontSize="13" LineHeight="1.35"
                           TextColor="{DynamicResource TextSecondary}" />
                    <HorizontalStackLayout Spacing="8" Margin="0,3,0,0">
                        <Border Padding="9,5" BackgroundColor="{DynamicResource AccentSurface}"
                                StrokeThickness="0" StrokeShape="RoundRectangle 10">
                            <Label Text="ALPHA" FontSize="9" FontAttributes="Bold"
                                   TextColor="{DynamicResource Accent}" />
                        </Border>
                        <Border Padding="9,5" BackgroundColor="{DynamicResource SurfaceRaised}"
                                StrokeThickness="0" StrokeShape="RoundRectangle 10">
                            <Label Text="PRÉVIA LOCAL" FontSize="9" FontAttributes="Bold"
                                   TextColor="{DynamicResource TextSecondary}" />
                        </Border>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout Spacing="10">
                <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                    <Label Text="Contas e conexões" FontSize="16" FontAttributes="Bold" />
                    <Label Grid.Column="1" Text="2 ETAPAS" FontSize="9"
                           CharacterSpacing="1" TextColor="{DynamicResource TextMuted}"
                           VerticalTextAlignment="Center" />
                </Grid>

                <Border Padding="15" BackgroundColor="{DynamicResource Surface}"
                        Stroke="{DynamicResource Border}" StrokeThickness="1"
                        StrokeShape="RoundRectangle 17">
                    <VerticalStackLayout Spacing="9">
                        <Grid ColumnDefinitions="42,*,Auto" ColumnSpacing="10">
                            <Border WidthRequest="40" HeightRequest="40"
                                    BackgroundColor="{DynamicResource SurfaceSubtle}"
                                    StrokeThickness="0" StrokeShape="RoundRectangle 13">
                                <Label Text="M" FontSize="20" FontAttributes="Bold"
                                       TextColor="{DynamicResource Accent}"
                                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Conta Microsoft" FontSize="14" FontAttributes="Bold" />
                                <Label Text="Identidade do aplicativo Agent" FontSize="11"
                                       TextColor="{DynamicResource TextSecondary}" />
                            </VerticalStackLayout>
                            <Border Grid.Column="2" Padding="8,5"
                                    BackgroundColor="{DynamicResource SurfaceRaised}"
                                    StrokeThickness="0" StrokeShape="RoundRectangle 9"
                                    VerticalOptions="Center">
                                <Label Text="PENDENTE" FontSize="8" FontAttributes="Bold"
                                       TextColor="{DynamicResource Warning}" />
                            </Border>
                        </Grid>
                        <Label Text="O cliente Android ainda precisa da configuração MSAL (Client ID e URI de redirecionamento) para iniciar o login com segurança." 
                               FontSize="11" LineHeight="1.25"
                               TextColor="{DynamicResource TextSecondary}" />
                    </VerticalStackLayout>
                </Border>

                <Border Padding="15" BackgroundColor="{DynamicResource Surface}"
                        Stroke="{DynamicResource Border}" StrokeThickness="1"
                        StrokeShape="RoundRectangle 17">
                    <VerticalStackLayout Spacing="9">
                        <Grid ColumnDefinitions="42,*,Auto" ColumnSpacing="10">
                            <Border WidthRequest="40" HeightRequest="40"
                                    BackgroundColor="{DynamicResource AccentSurface}"
                                    StrokeThickness="0" StrokeShape="RoundRectangle 13">
                                <Label Text="C" FontSize="20" FontAttributes="Bold"
                                       TextColor="{DynamicResource Accent}"
                                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Conta Codex" FontSize="14" FontAttributes="Bold" />
                                <Label Text="Conexão separada da conta Microsoft" FontSize="11"
                                       TextColor="{DynamicResource TextSecondary}" />
                            </VerticalStackLayout>
                            <Border Grid.Column="2" Padding="8,5"
                                    BackgroundColor="{DynamicResource SurfaceRaised}"
                                    StrokeThickness="0" StrokeShape="RoundRectangle 9"
                                    VerticalOptions="Center">
                                <Label Text="RUNTIME AUSENTE" FontSize="8" FontAttributes="Bold"
                                       TextColor="{DynamicResource Warning}" />
                            </Border>
                        </Grid>
                        <Label Text="O protocolo de login por código já existe no Agent.Core, mas o host nativo que inicia o Codex App Server ainda não está empacotado para Android." 
                               FontSize="11" LineHeight="1.25"
                               TextColor="{DynamicResource TextSecondary}" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <Border Padding="15" BackgroundColor="{DynamicResource AccentSurface}"
                    StrokeThickness="0" StrokeShape="RoundRectangle 16">
                <VerticalStackLayout Spacing="5">
                    <Label Text="O que está disponível agora" FontSize="13"
                           FontAttributes="Bold" TextColor="{DynamicResource Accent}" />
                    <Label Text="Você pode navegar pelas telas e avaliar o visual. Conversas, autenticação, plugins e execução de tarefas não estão ativos nesta build." 
                           FontSize="11" LineHeight="1.25" />
                </VerticalStackLayout>
            </Border>

            <Button Text="Explorar a prévia do aplicativo"
                    BackgroundColor="{DynamicResource AccentStrong}"
                    TextColor="White" HeightRequest="50"
                    Clicked="OnPreviewClicked" />
            <Label Text="A prévia não envia mensagens nem altera arquivos ou repositórios."
                   FontSize="10" TextColor="{DynamicResource TextMuted}"
                   HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
